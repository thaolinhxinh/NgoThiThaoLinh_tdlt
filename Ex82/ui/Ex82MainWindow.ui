         <widget class="QRadioButton" name="radioButtonGroup1">
          <property name="styleSheet">
           <string notr="true">
/* QRadioButton tổng thể */
QRadioButton {
    color: #1F2937;
    font-size: 18px;
    font-family: &quot;Segoe UI&quot;, BlinkMacSystemFont, sans-serif;
    spacing: 8px;
}

QRadioButton:disabled {
    color: #9CA3AF;
}

/* Kích thước khung Radio */
QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

/* Trạng thái: Chưa chọn */
QRadioButton::indicator:unchecked {
    border: 2px solid #D1D5DB;
    border-radius: 9px;
    background-color: #FFFFFF;
}

/* Trạng thái: Rê chuột khi chưa chọn */
QRadioButton::indicator:unchecked:hover {
    border-color: #3B82F6;
    background-color: #EFF6FF;
}

/* Trạng thái: Đã chọn */
QRadioButton::indicator:checked {
    border: 6px solid #2563EB;
    border-radius: 9px;
    background-color: #FFFFFF;
}

/* Trạng thái: Rê chuột khi đã chọn */
QRadioButton::indicator:checked:hover {
    border-color: #1D4ED8;
}

/* Trạng thái: Vô hiệu hóa (Disabled) */
QRadioButton::indicator:disabled {
    border-color: #E5E7EB;
    background-color: #F3F4F6;
}</string>
          </property>
          <property name="text">
           <string>Group 1</string>
